# Strata Repository Gitignore

# Core internal planning, tracking, and deep architecture analysis (Gitignored per project design)
info/
references/

# Local agent configuration, instructions, and task records (kept locally, never committed)
.opencode/
AGENTS.md
info/agent_tasks/

# Rust Cargo build artifacts
/target/
**/*.rs.bk

# Distribution and compiled bundles
dist/
build/
pkg/

# Platform native intermediate artifacts
*.apk
*.aab
*.ipa
*.app/
*.dSYM/

# IDE / Editor artifacts
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# OS specific files
Thumbs.db

# Node.js and VitePress documentation build artifacts
node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/
